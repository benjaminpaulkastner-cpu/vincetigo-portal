{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vincetigo-portal",
  "main": "worker.js",
  "compatibility_date": "2026-09-29",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vincetigo-portal",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PLAID_ENV": "sandbox",
    "PUBLIC_APP_URL": "http://127.0.0.1:5502"
  }
}